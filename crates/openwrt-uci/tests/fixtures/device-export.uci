	list tracks 'ping,208.67.220.220'

config member 'modem_1_1_2_6'
	option disabled '1'
	option addr_type '6'
	option metric '40'
	option track_mode 'passive'
	option weight '1'
	option interface 'modem_1_1_2_6'
	list tracks 'ping,2001:4860:4860::8844'
	list tracks 'ping,2001:4860:4860::8888'
	list tracks 'ping,2620:0:ccd::2'
	list tracks 'ping,2620:0:ccc::2'

config member 'secondwan'
	option interface 'secondwan'
	option addr_type '4'
	option track_mode 'force'
	option metric '15'
	option weight '1'
	option disabled '0'
	option check '1'
	list tracks 'ping,1.1.1.1'
	list tracks 'ping,8.8.8.8'
	list tracks 'ping,208.67.222.222'
	list tracks 'ping,208.67.220.220'

config member 'secondwan6'
	option interface 'secondwan6'
	option addr_type '6'
	option track_mode 'force'
	option metric '15'
	option weight '1'
	option disabled '1'
	list tracks 'ping,2001:4860:4860::8844'
	list tracks 'ping,2001:4860:4860::8888'
	list tracks 'ping,2620:0:ccd::2'
	list tracks 'ping,2620:0:ccc::2'

package minidlna

config minidlna 'config'
	option enabled '0'
	option user 'minidlna'
	option port '8200'
	option interface 'br-lan'
	option db_dir '/var/run/minidlna'
	option inotify '1'
	option enable_tivo '0'
	option wide_links '0'
	option strict_dlna '0'
	option notify_interval '900'
	option serial '12345678'
	option model_number '1'
	option root_container '.'
	option album_art_names 'Cover.jpg/cover.jpg/AlbumArtSmall.jpg/albumartsmall.jpg/AlbumArt.jpg/albumart.jpg/Album.jpg/album.jpg/Folder.jpg/folder.jpg/Thumb.jpg/thumb.jpg'
	option friendly_name 'GL-mt6000 DLNA Server'
	list media_dir '/tmp/mountd/disk1_part1'

package mptun

config mptun 'global'
	option enable '0'
	option enable_mpifd '1'
	option mptun 'mptun0'
	option tcpmark '0x1'
	option udpmark '0x2'
	option lanmark '0x4'
	option dnsmark '0x8'
	option mode '0'
	option node 'default'
	option base_url 'https://api.astrowarp.net'

config mptun 'config'
	option profile '/etc/mptun/mpnet.json'
	option sys_resolvfile '/tmp/resolv.conf.d/resolv.conf.auto'

config interface 'wan'
	option enable '1'
	option metric '1'
	list mptcp_flags 'subflow'
	option device 'eth1'

config interface 'secondwan'
	option enable '1'
	option metric '2'
	option device 'eth1'
	list mptcp_flags 'subflow'

config interface 'wwan'
	option enable '1'
	option metric '3'
	option device 'wlan-sta0'
	list mptcp_flags 'subflow'

config interface 'tethering'
	option enable '1'
	option metric '4'
	option device 'usb0'
	list mptcp_flags 'subflow'

config interface 'modem_0000_4'
	option enable '1'
	option device 'rmnet_mhi0'
	option metric '5'
	list mptcp_flags 'subflow'

package mtkhnat

config global 'global'
